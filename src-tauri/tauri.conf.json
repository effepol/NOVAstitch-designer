{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVAstitch Designer",
  "version": "0.2.1",
  "identifier": "it.poletticentrocucito.novastitch-designer",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "NOVAstitch Designer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Modern machine-embroidery editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "nsd"
        ],
        "name": "NOVAstitch Designer project",
        "description": "NOVAstitch Designer embroidery project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-novastitch-project",
        "exportedType": {
          "identifier": "it.poletticentrocucito.novastitch-designer.nsd",
          "conformsTo": [
            "public.json",
            "public.data"
          ]
        }
      },
      {
        "ext": [
          "pes",
          "dst",
          "jef",
          "exp",
          "vp3",
          "xxx",
          "pec",
          "u01",
          "tbf",
          "sew",
          "hus",
          "shv",
          "pcs",
          "dsb",
          "dsz",
          "ksm",
          "phb",
          "phc",
          "zxy",
          "zhs",
          "emd",
          "stx",
          "jpx"
        ],
        "name": "Embroidery file",
        "role": "Viewer"
      }
    ]
  }
}
